      lapply(registros, function(z) {
        tibble(
          fy = as.integer(z$fy %||% NA_integer_),
          fp = as.character(z$fp %||% NA_character_),
          form = as.character(z$form %||% NA_character_),
          start = as.Date(z$start %||% NA_character_),
          end = as.Date(z$end %||% NA_character_),
          filed = as.Date(z$filed %||% NA_character_),
          valor = as.numeric(z$val %||% NA_real_),
          tag = tag,
          prioridad = i
        )
      })
    )

    tablas[[length(tablas) + 1]] <- tabla
  }

  if (!length(tablas)) return(tibble())

  bind_rows(tablas) %>%
    filter(
      form %in% c("10-Q", "10-K"),
      is.finite(valor),
      !is.na(end),
      !is.na(filed),
      fy >= anio_inicio,
      fy <= anio_fin,
      filed >= end,
      as.numeric(filed - end) <= 180
    ) %>%
    mutate(
      duracion = as.numeric(end - start) + 1
    )
}

