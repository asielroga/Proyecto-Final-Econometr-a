## Bloque 17. Rendimientos intradía dentro de cada sesión

```{r}
#Se calculan rendimientos dentro de cada sesión bursátil utilizando exclusivamente precios separados por el intervalo temporal esperado. También se generan rezagos de rendimiento y volumen, y se excluyen observaciones sin intervalos consecutivos suficientes, evitando unir artificialmente el cierre de un día con la apertura del siguiente.

crear_intradia <- function(x, f) {
  minutos <- c(`1min` = 1, `5min` = 5, `30min` = 30)[[f]]
  stopifnot(!anyDuplicated(x[c("Ticker", "Fecha_Hora")]))
  x %>% filter(Ticker %in% empresas, is.finite(Close), Close > 0) %>%
    arrange(Ticker, Fecha_Hora) %>% group_by(Ticker, Fecha) %>%
    mutate(Delta_Min = as.numeric(difftime(Fecha_Hora, lag(Fecha_Hora), units = "mins")),
           Retorno = if_else(!is.na(Delta_Min) & abs(Delta_Min - minutos) < 0.1,
                            Close / lag(Close) - 1, NA_real_),
           Log_Volumen = log1p(pmax(Volume, 0)),
           Retorno_Lag1 = lag(Retorno), Volumen_Lag1 = lag(Log_Volumen),
           Delta_Previa = lag(Delta_Min),
           # Los dos rezagos deben estar en intervalos consecutivos de la misma sesión.
           Valido = is.finite(Retorno) & is.finite(Retorno_Lag1) &
                    is.finite(Volumen_Lag1) & !is.na(Delta_Previa) &
                    abs(Delta_Previa - minutos) < 0.1) %>%
    ungroup() %>% filter(Valido) %>%
    select(Fecha, Fecha_Hora, Ticker, Retorno, Retorno_Lag1, Volumen_Lag1)
}
# Para evitar copiar tres bases enormes, se calculan y almacenan por separado.
intradia_modelable <- lapply(names(bases_intradia), function(f) crear_intradia(bases_intradia[[f]], f))
