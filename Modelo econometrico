    arrange(desc(end), prioridad, filed, .by_group = TRUE) %>%
    slice(1) %>%
    ungroup() %>%
    transmute(
      Trimestre = paste0(fy, "-", fp),
      Fecha_Cierre = end
    )

  q4 <- ingresos %>%
    filter(
      form == "10-K",
      fp == "FY",
      between(duracion, 330, 380)
    ) %>%
    group_by(fy) %>%
    arrange(desc(end), prioridad, filed, .by_group = TRUE) %>%
    slice(1) %>%
    ungroup() %>%
    transmute(
      Trimestre = paste0(fy, "-Q4"),
      Fecha_Cierre = end
    )

