## Bloque 19. Regresiones simples y múltiples intradía

```{r}
# Se dividen los días disponibles para cada frecuencia en 70% entrenamiento, 15% validación y 15% prueba. Para cada empresa se estima una regresión simple del retorno actual respecto a su retorno rezagado y una regresión múltiple que agrega el volumen rezagado. En total se generan sesenta modelos, treinta simples y treinta múltiples.

partir_intradia <- function(x) {
  fechas <- sort(unique(x$Fecha))
  if (length(fechas) < 12) return(x[FALSE, ] %>% mutate(Particion = character()))
  n <- length(fechas); a <- max(1, floor(n * .70)); b <- min(n - 1, max(a + 1, floor(n * .85)))
  x %>% mutate(Particion = case_when(Fecha <= fechas[a] ~ "Train",
                                      Fecha <= fechas[b] ~ "Validacion", TRUE ~ "Prueba"))
}
