    slice(1) %>%
    ungroup() %>%
    transmute(
      Trimestre = paste0(fy, "-", fp),
      Valor = valor
    )

  # Q4 = total anual - acumulado de 9 meses
  anuales <- datos %>%
    filter(
      fp == "FY",
      form == "10-K",
      duracion >= 330,
      duracion <= 380
    ) %>%
    arrange(fy, prioridad, filed) %>%
    group_by(fy) %>%
    slice(1) %>%
    ungroup() %>%
    select(
      fy,
      inicio_anual = start,
      fin_anual = end,
      valor_anual = valor
    )

  nueve_meses <- datos %>%
    filter(
      fp == "Q3",
      form == "10-Q",
      duracion >= 240,
      duracion <= 300
    ) %>%
    arrange(fy, prioridad, filed) %>%
    group_by(fy) %>%
    slice(1) %>%
    ungroup() %>%
    select(
      fy,
      inicio_9m = start,
      fin_9m = end,
      valor_9m = valor
    )

  cuarto_trimestre <- anuales %>%
    inner_join(nueve_meses, by = "fy") %>%
    filter(
      abs(as.numeric(inicio_anual - inicio_9m)) <= 7,
      as.numeric(fin_anual - fin_9m) >= 60,
      as.numeric(fin_anual - fin_9m) <= 110
    ) %>%
    transmute(
      Trimestre = paste0(fy, "-Q4"),
      Valor = valor_anual - valor_9m
    )

  bind_rows(trimestrales, cuarto_trimestre) %>%
    distinct(Trimestre, .keep_all = TRUE)
}

